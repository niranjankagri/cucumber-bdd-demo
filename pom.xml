<?xml version="1.0" encoding="UTF-8"?>

<!--
  Maven build of the Cucumber + Selenium BDD demo.
  Layout: features in src/test/resources/features, Java code in
  src/test/java/com/niranjankagri/cucumberdemo (runners, stepdefinitions, pages, hooks, utils).
  mvn test                          runs TestRunner and ExampleRunner (5 scenarios)
  mvn test -Dtest=ReportDemoRunner  runs the report demo (fails and skips on purpose)
  Browser, headless mode and URLs come from src/test/resources/config.properties,
  e.g. mvn test -Dbrowser=firefox -Dheadless=true
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.niranjankagri</groupId>
  <artifactId>cucumber-bdd-demo</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <name>cucumber-bdd-demo</name>
  <url>https://github.com/niranjankagri/cucumber-bdd-demo</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Java 1.7 no longer compiles on current JDKs -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <cucumber.version>8.0.4</cucumber.version>
  </properties>

  <!-- One JUnit 6 version for all JUnit modules (Cucumber 8's engine is built for JUnit 6) -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Cucumber: one version for every module (the old pom mixed 1.2.5, 6.9.1 and 6.11.0) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Cucumber engine for the JUnit Platform; the *Runner classes are JUnit Platform suites.
         (The JUnit 4 runner io.cucumber.junit.Cucumber is deprecated and marked for removal.) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- @Suite, @SelectClasspathResource, @ConfigurationParameter for the runners (version from the JUnit BOM) -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Assertions used in the step definitions -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JSON library (Jackson 2 + its jdk8 module) Cucumber needs to write its HTML and JSON reports -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
      <version>2.22.3</version>
      <scope>test</scope>
    </dependency>
    <!-- Browser automation; Selenium Manager downloads the matching driver itself -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.51.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Runs every *Runner class except the report demo (the default patterns would only pick up TestRunner) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <includes>
            <include>**/*Runner.java</include>
          </includes>
          <!-- Fails and skips on purpose; run it explicitly with -Dtest=ReportDemoRunner -->
          <excludes>
            <exclude>**/ReportDemoRunner.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
